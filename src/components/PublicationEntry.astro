---
interface Props {
  title: string;
  authors: string; // may contain **name** for bold
  venue: string;
  paperUrl?: string;
  doiUrl?: string;
  videoUrl?: string;
  previewVideo?: string;
  previewImage?: string;
  previewPlaceholder?: string;
  previewNote?: string;
  award?: string;
}

const props = Astro.props;

// Convert **text** to <strong>text</strong> for the author line
const authorsHtml = props.authors.replace(
  /\*\*(.+?)\*\*/g,
  '<strong>$1</strong>'
);

// Derive poster URL from video URL: /uploads/foo.mp4 -> /uploads/posters/foo.jpg
// (run generate-posters.bat to produce these files)
const posterUrl = props.previewVideo
  ? props.previewVideo
      .replace('/uploads/', '/uploads/posters/')
      .replace(/\.mp4$/i, '.jpg')
  : undefined;
---

<article class="entry">
  <div class="entry-media">
    {
      props.previewVideo ? (
        <video
          data-src={props.previewVideo}
          poster={posterUrl}
          autoplay
          muted
          loop
          playsinline
          preload="none"
          webkit-playsinline="true"
          x5-playsinline="true"
          x5-video-player-type="h5-page"
          controlsList="nodownload"
        />
      ) : props.previewPlaceholder ? (
        <div class="entry-placeholder" aria-label={`${props.title} preview coming soon`}>
          {props.previewImage && (
            <img class="entry-placeholder-image" src={props.previewImage} alt="" loading="lazy" />
          )}
          <div class="entry-placeholder-overlay">
            <span class="entry-placeholder-text">{props.previewPlaceholder}</span>
            {props.previewNote && <span class="entry-placeholder-note">{props.previewNote}</span>}
          </div>
        </div>
      ) : null
    }
  </div>
  <div>
    <h3 class="entry-title">{props.title}</h3>
    <p class="entry-authors" set:html={authorsHtml} />
    <p class="entry-venue">{props.venue}</p>
    <div class="entry-links">
      {
        props.paperUrl && (
          props.paperUrl === 'soon'
            ? (
              <span class="entry-link entry-link-disabled">
                <svg class="entry-link-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 3h7l4 4v14H7z" />
                  <path d="M14 3v5h5M9.5 13.5h5M9.5 17h4" />
                </svg>
                <span>pdf</span>
              </span>
            )
            : (
              <a href={props.paperUrl} class="entry-link" target="_blank" rel="noopener">
                <svg class="entry-link-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 3h7l4 4v14H7z" />
                  <path d="M14 3v5h5M9.5 13.5h5M9.5 17h4" />
                </svg>
                <span>pdf</span>
              </a>
            )
        )
      }
      {
        props.doiUrl && (
          props.doiUrl === 'soon'
            ? (
              <span class="entry-link entry-link-disabled">
                <svg class="entry-link-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 5h5v5M10 14l9-9M19 13v6H5V5h6" />
                </svg>
                <span>doi</span>
              </span>
            )
            : (
              <a href={props.doiUrl} class="entry-link" target="_blank" rel="noopener">
                <svg class="entry-link-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 5h5v5M10 14l9-9M19 13v6H5V5h6" />
                </svg>
                <span>doi</span>
              </a>
            )
        )
      }
      {
        props.videoUrl && (
          <a href={props.videoUrl} class="entry-link" target="_blank" rel="noopener">
            <svg class="entry-link-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path class="entry-link-icon-fill" d="m10 8 6 4-6 4z" />
            </svg>
            <span>video</span>
          </a>
        )
      }
    </div>
    {props.award && <p class="entry-award">{props.award}</p>}
  </div>
</article>
